{
  "name": "tauri-plugin-video-api",
  "version": "0.1.0",
  "author": "tauri-plugin-video contributors",
  "description": "Native, realtime MKV and broad-codec video for Tauri with headless and React APIs",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vynxc/tauri-video-plugin.git"
  },
  "homepage": "https://github.com/vynxc/tauri-video-plugin#readme",
  "bugs": "https://github.com/vynxc/tauri-video-plugin/issues",
  "sideEffects": false,
  "keywords": [
    "tauri",
    "video",
    "gstreamer",
    "mpv",
    "libvlc",
    "mkv",
    "android-tv"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "types": "./dist-js/guest-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "exports": {
    ".": {
      "types": "./dist-js/guest-js/index.d.ts",
      "import": "./dist-js/index.js",
      "require": "./dist-js/index.cjs"
    },
    "./headless": {
      "types": "./dist-js/guest-js/index.d.ts",
      "import": "./dist-js/index.js",
      "require": "./dist-js/index.cjs"
    },
    "./react": {
      "types": "./dist-js/react/index.d.ts",
      "import": "./dist-js/react.js",
      "require": "./dist-js/react.cjs"
    },
    "./react/styles.css": "./react/player.css"
  },
  "files": [
    "dist-js",
    "docs/*.md",
    "react/player.css",
    "README.md"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@noriginmedia/norigin-spatial-navigation": "^3.3.0",
    "@tauri-apps/api": "^2.0.0"
  },
  "peerDependencies": {
    "react": ">=18.2 <20",
    "react-dom": ">=18.2 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "happy-dom": "^20.11.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rollup": "^4.9.6",
    "tslib": "^2.8.1",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
