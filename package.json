{
  "name": "@get-air/video-tauri",
  "version": "0.4.0",
  "author": "Air contributors",
  "description": "Native Tauri backend adapter for @get-air/video",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-air/tauri-video-plugin.git"
  },
  "homepage": "https://github.com/get-air/tauri-video-plugin#readme",
  "bugs": "https://github.com/get-air/tauri-video-plugin/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "keywords": [
    "tauri",
    "video",
    "gstreamer",
    "media3",
    "libvlc",
    "mkv",
    "android-tv"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "types": "./dist-js/adapter/index.d.ts",
  "main": "./dist-js/index.js",
  "module": "./dist-js/index.js",
  "exports": {
    ".": {
      "types": "./dist-js/adapter/index.d.ts",
      "import": "./dist-js/index.js"
    },
    "./native": {
      "types": "./dist-js/adapter/native.d.ts",
      "import": "./dist-js/native.js"
    },
    "./effect": {
      "types": "./dist-js/adapter/effect.d.ts",
      "import": "./dist-js/effect.js"
    },
    "./framework": {
      "types": "./dist-js/adapter/framework.d.ts",
      "import": "./dist-js/framework.js"
    }
  },
  "files": [
    "dist-js",
    "docs/*.md",
    "CHANGELOG.md",
    "VERSIONING.md",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsx scripts/build.ts",
    "ci": "npm run check && npm run build && npm pack --dry-run --ignore-scripts",
    "ci:act": "act push --job guest-api",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run check:effect && npm test",
    "check:effect": "effect-language-service diagnostics --project tsconfig.json --strict --format text",
    "check:release": "node scripts/check-release-consistency.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run --exclude=target/**"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  },
  "allowScripts": { "esbuild": true },
  "dependencies": {
    "@get-air/http": "^0.1.0",
    "@plussub/srt-vtt-parser": "^2.0.5",
    "@tauri-apps/api": "^2.0.0",
    "effect": "^3.22.1"
  },
  "peerDependencies": {
    "@get-air/video": ">=0.3.0 <0.4.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@get-air/video": "0.3.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/node": "^24.13.3",
    "happy-dom": "^20.11.2",
    "rollup": "^4.9.6",
    "tslib": "^2.8.1",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
