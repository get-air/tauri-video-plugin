{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitAny": true,
    "noEmit": true,
    "plugins": [{ "name": "@effect/language-service" }]
  },
  "include": [
    "adapter/**/*.ts",
    "guest-js/index.ts",
    "guest-js/index.test.ts",
    "guest-js/native-surface-layout.ts",
    "guest-js/native-surface-compositor.ts",
    "guest-js/native-surface-compositor.test.ts",
    "scripts/**/*.ts",
    "qualification/**/*.ts",
    "rollup.config.ts"
  ],
  "exclude": ["dist-js", "node_modules", "qualification/fixtures"]
}
