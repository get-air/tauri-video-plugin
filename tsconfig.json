{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitAny": true,
    "noEmit": true
  },
  "include": [
    "guest-js/**/*.ts",
    "blits/**/*.ts",
    "react/**/*",
    "scripts/**/*.ts",
    "qualification/**/*.ts",
    "rollup.config.ts"
  ],
  "exclude": ["dist-js", "node_modules", "guest-js/*.test.ts", "qualification/fixtures"]
}
